# Public application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase browser-safe values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-only value
SUPABASE_SERVICE_ROLE_KEY=

# Direct database connection used by Drizzle/migrations
DATABASE_URL=
DATABASE_MIGRATION_URL=

# GitHub OAuth used by Supabase is normally configured in the Supabase dashboard.
# Keep these names documented if local/server code needs them.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_INSTALLATION_CALLBACK_URL=http://localhost:3000/api/github/install/callback

# Internal worker authentication
INTERNAL_WORKER_SECRET=

# Slack core assessment integration
SLACK_WEBHOOK_URL=

# Optional AI enrichment (server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Logging
LOG_LEVEL=info
